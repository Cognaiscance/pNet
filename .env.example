# pNet configuration
# Set PNET_HOST to your LAN IP so other nodes can reach you when sharing connection codes.
PNET_HOST=192.168.1.x

# Rails server port (default: 3000)
# PORT=3000

# UDP listener port (default: 7777)
# PNET_UDP_PORT=7777

# Relay server address for reconnecting through a third node when direct connection fails (host:port)
# PNET_RELAY_HOST=relay.example.com:7777
