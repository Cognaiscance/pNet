<h1>Pending App Registrations</h1>

<% if @pending_apps.empty? %>
  <p>No apps are waiting for approval.</p>
<% else %>
  <table style="width:100%;border-collapse:collapse;">
    <thead>
      <tr style="background:#f0f0f0;">
        <th style="padding:0.5rem;text-align:left;">App Name</th>
        <th style="padding:0.5rem;text-align:left;">App UUID</th>
        <th style="padding:0.5rem;text-align:left;">Host</th>
        <th style="padding:0.5rem;text-align:left;">Requested</th>
        <th style="padding:0.5rem;text-align:left;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @pending_apps.each do |app| %>
        <tr style="border-bottom:1px solid #ddd;">
          <td style="padding:0.5rem;"><%= app.app_name %></td>
          <td style="padding:0.5rem;"><code><%= app.app_uuid %></code></td>
          <td style="padding:0.5rem;"><%= app.active_connection&.host_name %></td>
          <td style="padding:0.5rem;"><%= app.created_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td style="padding:0.5rem;">
            <%= button_to "Accept", accept_ui_pending_app_path(app), method: :post,
                style: "background:#28a745;color:#fff;border:none;padding:0.25rem 0.75rem;border-radius:3px;cursor:pointer;margin-right:0.5rem;" %>
            <%= button_to "Reject", reject_ui_pending_app_path(app), method: :post,
                style: "background:#dc3545;color:#fff;border:none;padding:0.25rem 0.75rem;border-radius:3px;cursor:pointer;" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
