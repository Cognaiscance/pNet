<h1>Connection Code</h1>

<section style="margin-bottom:2rem;">
  <h2>Your Connection Code</h2>

  <% if @host_missing %>
    <p style="background:#fff3cd;border:1px solid #ffc107;padding:0.75rem;border-radius:4px;">
      <strong>Warning:</strong> <code>PNET_HOST</code> is not set. Set it to your LAN IP before sharing this code
      (e.g. <code>PNET_HOST=192.168.1.x rails server</code>).
    </p>
  <% end %>

  <p>Share this code with the other node. It expires at <strong><%= @expires_at %></strong>.</p>

  <textarea readonly rows="4" style="width:100%;font-family:monospace;padding:0.5rem;word-break:break-all;"><%= @code %></textarea>

  <button onclick="navigator.clipboard.writeText(document.querySelector('textarea').value)"
          style="margin-top:0.5rem;padding:0.5rem 1rem;background:#1a1a2e;color:#fff;border:none;border-radius:4px;cursor:pointer;">
    Copy to Clipboard
  </button>
</section>

<hr style="margin:2rem 0;">

<section>
  <h2>Import a Connection Code</h2>
  <p>Paste a connection code from another node to add them as a contact.</p>

  <%= form_with url: ui_connection_code_path, method: :post do |f| %>
    <%= f.label :code, "Connection Code" %><br>
    <%= f.text_area :code, rows: 4,
        placeholder: "Paste connection code here...",
        style: "width:100%;font-family:monospace;padding:0.5rem;margin-top:0.25rem;word-break:break-all;" %>
    <br>
    <%= f.submit "Import", style: "margin-top:0.5rem;padding:0.5rem 1rem;background:#1a1a2e;color:#fff;border:none;border-radius:4px;cursor:pointer;" %>
  <% end %>
</section>
