<h1>My Devices</h1>

<p>
  <%= link_to "Pair a new device", ui_device_pairing_code_path %>
  &nbsp;|&nbsp;
  <%= button_to "Sync apps to sibling devices", sync_ui_devices_path, method: :post %>
</p>

<% if flash[:notice] %>
  <p style="color:green;"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert] %>
  <p style="color:red;"><%= flash[:alert] %></p>
<% end %>

<% if @devices.empty? %>
  <p>No devices configured.</p>
<% else %>
  <% @devices.each do |device| %>
    <div style="border:1px solid #ddd;border-radius:6px;padding:1rem;margin-bottom:1rem;">
      <h3><%= device.alias %></h3>
      <p><strong>UUID:</strong> <code><%= device.uuid %></code></p>
      <% conn = device.active_connection %>
      <% if conn %>
        <p><strong>Connection:</strong> <%= conn.host_name %> (<%= conn.protocol %>)</p>
        <p><strong>Last updated:</strong> <%= conn.created_at.strftime("%Y-%m-%d %H:%M") %></p>
      <% else %>
        <p><em>No active connection.</em></p>
      <% end %>

      <% accepted_apps = device.apps.select(&:accepted?) %>
      <% if accepted_apps.any? %>
        <p><strong>Apps:</strong></p>
        <ul>
          <% accepted_apps.each do |app| %>
            <li><%= app.app_name %> <small>(<code><%= app.app_uuid %></code>)</small></li>
          <% end %>
        </ul>
      <% else %>
        <p><em>No accepted apps.</em></p>
      <% end %>
    </div>
  <% end %>
<% end %>
