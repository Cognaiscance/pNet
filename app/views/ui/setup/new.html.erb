<h1>Welcome to pNet &mdash; Initial Setup</h1>

<%= form_with url: ui_setup_path, method: :post do |f| %>
  <fieldset style="border:1px solid #ccc;padding:1rem;border-radius:4px;margin-bottom:1.5rem;">
    <legend><strong>New identity</strong></legend>
    <p style="color:#555;font-size:0.9rem;margin-top:0;">Create a brand new user on this device.</p>
    <div style="margin-bottom:1rem;">
      <%= f.label :user_alias, "Your alias (display name)" %><br>
      <%= f.text_field :user_alias, placeholder: "e.g. Alice", style: "padding:0.5rem;width:300px;" %>
    </div>
  </fieldset>

  <fieldset style="border:1px solid #ccc;padding:1rem;border-radius:4px;margin-bottom:1.5rem;">
    <legend><strong>Existing identity (optional)</strong></legend>
    <p style="color:#555;font-size:0.9rem;margin-top:0;">
      Paste a device pairing code from your other device to join as the same user.
      Your alias will be taken from the code. Leave blank to use a new identity above.
    </p>
    <div>
      <%= f.label :pairing_code, "Device Pairing Code" %><br>
      <%= f.text_area :pairing_code, rows: 3,
          placeholder: "Paste pairing code here...",
          style: "width:100%;font-family:monospace;padding:0.5rem;margin-top:0.25rem;" %>
    </div>
  </fieldset>

  <div style="margin-bottom:1.5rem;">
    <%= f.label :device_alias, "This device's alias" %><br>
    <%= f.text_field :device_alias, placeholder: "e.g. Laptop", required: true, style: "padding:0.5rem;width:300px;" %>
  </div>

  <%= f.submit "Configure Node", style: "padding:0.5rem 1rem;background:#1a1a2e;color:#fff;border:none;border-radius:4px;cursor:pointer;" %>
<% end %>
