# Live multi-machine test topology — real hardware, driven over SSH.
# Sourced by lib.sh. See tests/live/README.md.
#
# ── Networks (do not put VPN/Tailscale addresses in PNET_HOSTS) ─────────────
#   sanosuke (this box)  office 192.168.50.* + VPN → home 192.168.1.*
#                        Orchestration only (ssh, curl admin/probes).
#   n64                  house 192.168.1.40 — public SG anchor
#                        pnet.thehomegarage.com → UDP 7777 (+ optional 7778)
#   tealface             office 192.168.50.63 — DietPi aarch64 (Pi 3)
#                        joins over the *public* name (real WAN/NAT path)
#   zeus                 house 192.168.1.116 — receives aarch64 bins; optional
#                        future LAN peer (not a pNet node in this topology)
#   golden               unplugged (was 192.168.1.235)
#   aarch64 builds       on sanosuke (cross-compile), pushed to tealface + zeus
#
# Data plane rule: nodes must reach each other without sanosuke's VPN and
# without Tailscale. Cross-site traffic uses pnet.thehomegarage.com only.
# House-LAN-only peers may use 192.168.1.* among themselves when added later.
#
# ── Topology (WAN DG join / P4-style) ───────────────────────────────────────
#   alice: alice_n64 (SG-new, rank1, public hosts) + alice_tealface (DG join)
#   Probes: one on the SG, one on the office DG.

# Remote install root on every host (under the ssh user's HOME).
REMOTE_DIR="pnet-live"

# Public name + LAN IP of the anchor (LAN IP is for *observation* from
# sanosuke via VPN only — never put it in PNET_HOSTS for this topology).
N64_PUBLIC="pnet.thehomegarage.com"
N64_LAN="192.168.1.40"
TEALFACE_LAN="192.168.50.63"
ZEUS_LAN="192.168.1.116"

# ── Node roster ────────────────────────────────────────────────────────────
# Each NODE_<name> = ssh_host|grade|user_alias|device_alias|rank|udp|http|hosts|role
#   role: "new" (SG-new, uses user_alias) or "join" (needs invitation code)
#   hosts: PNET_HOSTS advertised value; "" = unset (DG join does not need it)
#   rank: meaningful for SG only; DG may use 0
# Instances on the same ssh_host MUST differ in udp, http, and HOME.

NODES=(alice_n64 alice_tealface)

# Rank-1 SG: advertise *public* host only so the office DG dials the real
# internet path (not 192.168.1.40, not Tailscale, not the VPN).
NODE_alice_n64="n64|sg|alice|alice-n64|1|7777|8777|${N64_PUBLIC}:7777|new"

# Office DG: initiates bootstrap to the SG via the invitation (which carries
# the public host). No PNET_HOSTS — DG is not a directory publisher.
NODE_alice_tealface="tealface|dg|alice|alice-tealface|0|7777|8777||join"

# Which node each "join" node bootstraps from (user's rank-1 SG).
JOIN_FROM_alice_tealface="alice_n64"

# ── Probe roster (one per pNet node; registered app + /status oracle) ──────
# Each PROBE_<name> = ssh_host|pnet_addr|alias|http_bind|push_port|ctrl_port
PROBES=(p_alice_n64 p_alice_tealface)

# n64 :3000 is often taken by other apps (Rails); use 3100 for the probe oracle.
PROBE_p_alice_n64="n64|127.0.0.1:7777|alice-n64-app|0.0.0.0:3100|8888|8889"
PROBE_p_alice_tealface="tealface|127.0.0.1:7777|alice-tealface-app|0.0.0.0:3000|8888|8889"

# Reachable admin-UI + probe URLs from sanosuke (orchestration path — VPN/LAN OK).
ADMIN_alice_n64="http://${N64_LAN}:8777"
ADMIN_alice_tealface="http://${TEALFACE_LAN}:8777"

PROBE_URL_p_alice_n64="http://${N64_LAN}:3100"
PROBE_URL_p_alice_tealface="http://${TEALFACE_LAN}:3000"
