# Live multi-machine test topology — real hardware, driven over SSH.
# Sourced by lib.sh. See tests/live/README.md.
#
# Hosts (ssh aliases from ~/.ssh/config):
#   n64            x86_64, public anchor (pnet.thehomegarage.com), UDP 7777+7778 fwd
#   golden         aarch64 Pi, LAN 192.168.1.235, ssh root
#   zeus           aarch64 Pi, LAN 192.168.1.116, ssh root
#   stealth-bomber aarch64,    office/WAN, reaches others only via n64's public name
#
# Topology:
#   alice (2 SGs): alice@n64:7777 rank1 (public) + alice@golden rank2 (LAN)
#   bob   (3 SGs): bob@n64:7778 rank1 (public) + bob@zeus rank2 (LAN)
#                                              + bob@stealth rank3 (WAN/office)
#   contacts: alice <-> bob
#   WAN DG: alice DG on stealth (P4)

# Remote install root on every host (under the ssh user's HOME).
REMOTE_DIR="pnet-live"

# Public name + LAN IP of the anchor.
N64_PUBLIC="pnet.thehomegarage.com"
N64_LAN="192.168.1.40"
GOLDEN_LAN="192.168.1.235"
ZEUS_LAN="192.168.1.116"

# ── Node roster ────────────────────────────────────────────────────────────
# Each NODE_<name> = ssh_host|grade|user_alias|device_alias|rank|udp|http|hosts|role
#   role: "new" (SG-new, uses user_alias) or "join" (uses an invitation code)
#   hosts: PNET_HOSTS advertised value (comma-separated host[:port]); "" = none
# Instances on the same ssh_host MUST differ in udp, http, and HOME (=REMOTE_DIR/<name>).

# LAN-focused cross-user topology (P3 re-verify). Both users' anchors are on
# DIFFERENT physical hosts and advertise LAN IPs only — so alice<->bob traffic
# uses real LAN routing, never hairpin NAT. (The earlier public-IP topology hit
# hairpin because both users were co-located on n64; and pNet dials only the
# first advertised host, so LAN+WAN can't coexist on one node. stealth/WAN is
# set aside here — it needs n64's public forwarding, which bob's golden anchor
# lacks.)
#   alice: alice-n64 (rank1)
#   bob:   bob-golden (rank1) + bob-zeus (rank2)
NODES=(alice_n64 bob_golden bob_zeus)

NODE_alice_n64="n64|sg|alice|alice-n64|1|7777|8777|${N64_LAN}:7777|new"
NODE_bob_golden="golden|sg|bob|bob-golden|1|7777|8777|${GOLDEN_LAN}:7777|new"
NODE_bob_zeus="zeus|sg|bob|bob-zeus|2|7777|8777|${ZEUS_LAN}:7777|join"

# Which node each "join" node bootstraps from (its user's rank-1 SG).
JOIN_FROM_bob_zeus="bob_golden"

# ── Probe roster (one per SG; the registered app + /status oracle) ───────────
# Each PROBE_<name> = ssh_host|pnet_addr|alias|http_bind|push_port|ctrl_port
# Co-located probes (two on n64) need distinct http/push/ctrl ports. zeus has a
# pre-existing service on :3000, so p_bob_zeus uses :3010.
PROBES=(p_alice_n64 p_bob_golden p_bob_zeus)

PROBE_p_alice_n64="n64|127.0.0.1:7777|alice-n64-app|0.0.0.0:3000|8888|8889"
PROBE_p_bob_golden="golden|127.0.0.1:7777|bob-golden-app|0.0.0.0:3000|8888|8889"
PROBE_p_bob_zeus="zeus|127.0.0.1:7777|bob-zeus-app|0.0.0.0:3010|8888|8889"

# Reachable admin-UI + probe URLs from the dev box (it routes to all hosts).
ADMIN_alice_n64="http://${N64_LAN}:8777"
ADMIN_bob_golden="http://${GOLDEN_LAN}:8777"
ADMIN_bob_zeus="http://${ZEUS_LAN}:8777"

PROBE_URL_p_alice_n64="http://${N64_LAN}:3000"
PROBE_URL_p_bob_golden="http://${GOLDEN_LAN}:3000"
PROBE_URL_p_bob_zeus="http://${ZEUS_LAN}:3010"
